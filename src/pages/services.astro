---
import Layout from '../layouts/Layout.astro';
import ServicesHero from '../components/services/ServicesHero.astro';
import ServiceChapter from '../components/services/ServiceChapter.astro';
import ServicesMethod from '../components/services/ServicesMethod.astro';
import { services } from '../data/services';
import '../styles/services-page.css';
---

<Layout
  title="Servicios | edd n' dev"
  description="Sitios medibles, automatización, catálogos y software con alcance, operación y seguimiento definidos."
  breadcrumbs={[{ name: 'Servicios', url: '/services' }]}
>
  <div class="services-page" data-services-page>
    <ServicesHero />
    <div id="service-catalogue" class="services-catalogue" tabindex="-1">
      {services.map((service, index) => <ServiceChapter service={service} index={index} />)}
    </div>
    <ServicesMethod />
  </div>
</Layout>
