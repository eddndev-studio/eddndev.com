---
import Layout from '../layouts/Layout.astro';
import ServicesHero from '../components/services/ServicesHero.astro';
import ServiceChapter from '../components/services/ServiceChapter.astro';
import ServicesMethod from '../components/services/ServicesMethod.astro';
import { services } from '../data/services';
import '../styles/services-page.css';
---

<Layout
  title="Diseño web, software y automatización | edd n' dev"
  description="Diseño y desarrollo de sitios web, automatización con IA, comercio electrónico y software a medida en México. Una práctica de The Dash Studios."
  breadcrumbs={[{ name: 'Servicios', url: '/services/' }]}
  structuredData={{
    '@type': 'OfferCatalog',
    name: 'Servicios de edd n\' dev',
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: service.title,
        description: service.description,
        url: `https://eddndev.com/services/#${service.id}`,
        provider: { '@id': 'https://eddndev.com/#organization' },
      },
    })),
  }}
>
  <div class="services-page" data-services-page>
    <ServicesHero />
    <div id="service-catalogue" class="services-catalogue" tabindex="-1">
      {services.map((service, index) => <ServiceChapter service={service} index={index} />)}
    </div>
    <ServicesMethod />
  </div>
</Layout>
