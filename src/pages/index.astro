---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Container from '../components/studio/Container.astro';
import FadeIn from '../components/studio/FadeIn.astro';
import HomeEnsamble from '../components/studio/HomeEnsamble.astro';
import ServicePerforations from '../components/studio/ServicePerforations.astro';
import StudioStatement from '../components/studio/StudioStatement.astro';
import ProcessStatement from '../components/studio/ProcessStatement.astro';
import ContactSection from '../components/studio/ContactSection.astro';
import WorkShowcase from '../components/work/WorkShowcase.astro';
import { services } from '../data/services';

const projects = await getCollection('work');
const preferredOrder = ['ataulfo', 'sylestudio', 'achronyme'];
const ordered = preferredOrder
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
---

<Layout
  contactEnding
  title="edd n' dev | Estudio de diseño y software"
  description="Diseñamos y construimos sitios, automatizaciones y software para presentar una oferta, ordenar un proceso o lanzar un producto."
>
  <HomeEnsamble />

  <StudioStatement />

  <section id="services" data-services-section class="service-section scroll-mt-20 py-24 sm:py-32 lg:py-40">
    <Container class="service-section__content">
      <FadeIn class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="section-code">Servicios</p>
          <h2 class="service-section__title type-wide mt-8 max-w-5xl font-display text-[clamp(3rem,7vw,7.5rem)] leading-[0.84] font-medium tracking-[-0.06em]">Qué hacemos</h2>
        </div>
        <p class="service-section__intro max-w-md text-xl lg:col-span-4">Ayudamos a presentar una oferta, conectar herramientas, automatizar un flujo o construir software propio.</p>
      </FadeIn>
      <ServicePerforations services={services} />
    </Container>
  </section>

  <WorkShowcase projects={ordered} />

  <ProcessStatement />

  <ContactSection form />
</Layout>
