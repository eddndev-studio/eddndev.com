---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Container from '../components/studio/Container.astro';
import FadeIn from '../components/studio/FadeIn.astro';
import FadeInStagger from '../components/studio/FadeInStagger.astro';
import Button from '../components/studio/Button.astro';
import SectionIntro from '../components/studio/SectionIntro.astro';
import ServiceField from '../components/studio/ServiceField.astro';
import StudioStatement from '../components/studio/StudioStatement.astro';
import ContactSection from '../components/studio/ContactSection.astro';
import ProjectGrid from '../components/work/ProjectGrid.astro';
import { services } from '../data/services';

const offers = [
  { number: '01', title: 'Landing medible', price: 'Desde $20,000 MXN', time: '2 a 3 semanas', body: 'Una página con diseño propio, acciones medibles, publicación y panel privado.' },
  { number: '02', title: 'Landing de captación', price: 'Desde $35,000 MXN', time: '3 a 5 semanas', body: 'Oferta, formulario con reglas, seguimiento de solicitudes y una integración comercial.' },
  { number: '03', title: 'Sitio profesional', price: 'Desde $55,000 MXN', time: '5 a 8 semanas', body: 'Varias páginas, contenido administrable, medición y un panel para operar el sitio.' },
];

const projects = await getCollection('work');
const preferredOrder = ['ataulfo', 'sylestudio', 'achronyme'];
const ordered = preferredOrder
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
---

<Layout
  title="edd n' dev | Desarrollo de software independiente"
  description="Diseño y construyo sitios medibles, sistemas operativos y automatizaciones con alcance, pruebas y seguimiento claros."
>
  <Container class="mt-24 sm:mt-32 lg:mt-40">
    <FadeIn class="relative grid min-h-[50rem] grid-cols-1 content-start gap-x-8 lg:min-h-[55rem] lg:grid-cols-12">
      <div class="relative lg:col-span-12">
        <p class="section-code">Desarrollo independiente / México / Proyectos selectos</p>
        <h1 class="type-wide mt-12 font-display text-[clamp(3rem,12.5vw,11rem)] leading-[0.76] font-medium tracking-[-0.07em] text-white sm:text-[clamp(4rem,11.5vw,11rem)]">
          <span class="block">Sitios.</span>
          <span class="block lg:ml-[16vw]">Sistemas.</span>
          <span class="block text-[var(--signal-on-dark)]">Automatización.</span>
        </h1>
      </div>
      <div class="relative mt-16 border-t border-white/20 pt-6 lg:col-span-4 lg:col-start-8 lg:mt-20">
        <p class="text-xl text-neutral-700">Soy Eduardo. Diseño y construyo productos digitales para negocios que necesitan ordenar un proceso, atender mejor o lanzar una idea propia.</p>
        <p class="mt-5 text-base text-neutral-500">El alcance, la evidencia y la responsabilidad quedan visibles desde el inicio.</p>
        <div class="mt-8 flex flex-wrap items-center gap-6">
          <Button href="/contact">Platicar una necesidad</Button>
          <a href="#work" class="type-narrow border-b border-white/30 text-sm font-bold tracking-[0.08em] text-white uppercase transition-colors hover:border-brand hover:text-brand">Ver trabajo verificable</a>
        </div>
      </div>
    </FadeIn>
  </Container>

  <StudioStatement />

  <section id="services" data-services-section class="service-section section-plane scroll-mt-20 py-24 sm:py-32 lg:py-40">
    <ServiceField />
    <Container class="service-section__content">
      <FadeIn class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="section-code">Servicios</p>
          <h2 class="type-wide mt-8 max-w-5xl font-display text-[clamp(3rem,7vw,7.5rem)] leading-[0.84] font-medium tracking-[-0.06em] text-white">Qué ofrezco</h2>
        </div>
        <p class="max-w-md text-lg text-neutral-700 lg:col-span-4">Diseño, desarrollo y operación para presentar una oferta, conectar herramientas o construir un producto propio.</p>
      </FadeIn>

      <div data-service-explorer class="service-explorer mt-20">
        <FadeInStagger as="ol" class="service-explorer__list editorial-list">
          {services.map((service, index) => (
            <FadeIn
              as="li"
              data-service-row
              data-service-index={index}
              data-editorial-row
              class="service-row group py-10 sm:py-12"
            >
              <a href={`/services#${service.id}`} class="service-row__link">
                <div class="service-row__heading">
                  <p class="section-code">{service.number}</p>
                  <h3 class="type-wide mt-8 font-display text-[clamp(2.4rem,5vw,5rem)] leading-[0.9] font-medium tracking-[-0.045em] text-white">{service.title}</h3>
                </div>
                <div class="service-row__detail">
                  <p class="max-w-lg text-lg text-neutral-700">{service.tagline}.</p>
                  <p class="type-narrow mt-7 text-xs tracking-[0.08em] text-neutral-500 uppercase">{service.highlights.slice(0, 2).join(' / ')}</p>
                </div>
                <span class="service-row__arrow text-sm text-neutral-500" aria-hidden="true">-&gt;</span>
              </a>
            </FadeIn>
          ))}
        </FadeInStagger>
      </div>
    </Container>
  </section>

  <SectionIntro eyebrow="Evidencia" title="Trabajo que se puede revisar." id="work" class="mt-24 scroll-mt-24 sm:mt-32 lg:mt-40">
    <p>Cada caso indica su estado actual. Los resultados aparecen únicamente cuando existen datos verificables y permiso para publicarlos.</p>
  </SectionIntro>
  <Container class="mt-16">
    <ProjectGrid projects={ordered} />
    <FadeIn class="mt-10 flex justify-end">
      <a href="/work" class="type-narrow border-b border-white/30 text-sm font-bold tracking-[0.08em] text-white uppercase transition-colors hover:border-brand hover:text-brand">Ver todo el trabajo</a>
    </FadeIn>
  </Container>

  <SectionIntro id="pricing" eyebrow="Inversión" title="Tres puntos de entrada." class="mt-24 scroll-mt-20 sm:mt-32 lg:mt-40">
    <p>Precios base para proyectos web. Comercio, software a medida e integraciones se cotizan después de revisar el proceso.</p>
  </SectionIntro>
  <Container class="mt-16">
    <FadeInStagger class="editorial-list grid grid-cols-1">
      {offers.map((offer) => (
        <FadeIn as="article" data-editorial-row class="grid grid-cols-1 gap-x-8 gap-y-5 py-8 sm:grid-cols-2 sm:py-10 lg:grid-cols-12 lg:items-center">
          <p class="section-code lg:col-span-1">{offer.number}</p>
          <h3 class="type-wide font-display text-3xl font-semibold text-white lg:col-span-3">{offer.title}</h3>
          <p class="text-neutral-700 lg:col-span-4">{offer.body}</p>
          <div class="sm:text-right lg:col-span-3 lg:col-start-10">
            <p class="font-display text-xl font-semibold text-white">{offer.price}</p>
            <p class="mt-1 text-sm text-neutral-500">{offer.time}</p>
          </div>
        </FadeIn>
      ))}
    </FadeInStagger>
    <FadeIn class="mt-8 max-w-3xl text-sm text-neutral-600">
      <p>Los montos son precios de entrada en MXN. Dominio, pauta, suscripciones, contenido especializado e integraciones externas se dimensionan por separado.</p>
    </FadeIn>
  </Container>

  <ContactSection title="Cuéntame dónde se atasca el trabajo." buttonText="Iniciar conversación" />
</Layout>
