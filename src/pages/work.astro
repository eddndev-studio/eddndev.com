---
import Layout from '../layouts/Layout.astro';
import Container from '../components/studio/Container.astro';
import PageIntro from '../components/studio/PageIntro.astro';
import ContactSection from '../components/studio/ContactSection.astro';
import ProjectGrid from '../components/work/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('work');
const preferredOrder = ['ataulfo', 'sylestudio', 'achronyme'];
projects.sort((a, b) => preferredOrder.indexOf(a.slug) - preferredOrder.indexOf(b.slug));
---

<Layout
    title="Proyectos | edd n' dev"
    description="Productos propios y colaboraciones que distinguen lo publicado, el trabajo en curso y la evidencia disponible."
    breadcrumbs={[{ name: "Proyectos", url: "/work/" }]}
>
    <!-- HERO -->
    <PageIntro eyebrow="Archivo" title="Proyectos seleccionados.">
      <p>
        Reunimos productos propios y colaboraciones. Cada caso separa lo publicado, el trabajo en curso y los resultados que ya se pueden documentar.
      </p>
    </PageIntro>

    <!-- ARCHIVO -->
    <Container class="mt-24 sm:mt-32 lg:mt-40">
      <ProjectGrid projects={projects} />
    </Container>

    <!-- CTA -->
    <ContactSection
      title="¿Hay un proceso que valga la pena revisar?"
    />
</Layout>
