---
import Layout from '../layouts/Layout.astro';
import AutomationHero from '../components/automation/AutomationHero.astro';
import ProblemSection from '../components/automation/ProblemSection.astro';
import SolutionSection from '../components/automation/SolutionSection.astro';
import UseCasesSection from '../components/automation/UseCasesSection.astro';
import ProcessSection from '../components/automation/ProcessSection.astro';
import ResultsSection from '../components/automation/ResultsSection.astro';
import CtaSection from '../components/automation/CtaSection.astro';
---

<Layout
    title="Automatización con IA | edd n' dev"
    description="Construimos automatizaciones y agentes con reglas, permisos, bitácoras y puntos de aprobación para procesos operativos."
    breadcrumbs={[{ name: "Automatización", url: "/automation/" }]}
    structuredData={{
        '@type': 'Service',
        name: 'Automatización con IA',
        description: 'Automatizaciones, agentes e integraciones para procesos operativos, con reglas, permisos y bitácoras.',
        serviceType: 'Automatización de procesos con inteligencia artificial',
        provider: { '@id': 'https://eddndev.com/#organization' },
    }}
>
    <AutomationHero />
    <ProblemSection />
    <SolutionSection />
    <UseCasesSection />
    <ProcessSection />
    <ResultsSection />
    <CtaSection />
</Layout>
