---
import Layout from '../layouts/Layout.astro';
import Container from '../components/studio/Container.astro';
import FadeIn from '../components/studio/FadeIn.astro';
import PageIntro from '../components/studio/PageIntro.astro';
import SectionIntro from '../components/studio/SectionIntro.astro';
import List from '../components/studio/List.astro';
import ListItem from '../components/studio/ListItem.astro';
import TagList from '../components/studio/TagList.astro';
import TagListItem from '../components/studio/TagListItem.astro';

const briefing = [
  'Qué ocurre hoy y en qué momento se detiene el trabajo.',
  'Qué resultado te gustaría ver durante la primera etapa.',
  'Qué herramientas, sitio o proceso ya existen.',
  'Si hay una fecha, presupuesto o restricción que debamos considerar.',
];

const methods = [
  {
    label: 'Correo',
    value: 'contacto@eddndev.com',
    href: 'mailto:contacto@eddndev.com',
    detail: 'Ideal si quieres compartir contexto, enlaces o requerimientos. Puedes empezar con cuatro o cinco líneas.',
  },
  {
    label: 'Chat directo',
    value: '+52 56 1943 3938',
    href: 'https://wa.me/525619433938',
    external: true,
    detail: 'Útil para una primera pregunta, revisar si hay encaje o coordinar una llamada breve.',
  },
];

const facts = [
  { label: 'Inicio', value: 'Contexto breve' },
  { label: 'Base', value: 'México · GMT-6' },
];

const socials = [
  { label: 'LinkedIn', url: 'https://linkedin.com/in/eddndev' },
  { label: 'GitHub', url: 'https://github.com/eddndev-studio' },
  { label: 'Instagram', url: 'https://instagram.com/eddn.dev' },
  { label: 'Achronyme', url: 'https://github.com/achronyme' },
];
---

<Layout
    title="Contacto | edd n' dev"
    description="Escríbenos con el proceso actual, el resultado que buscas y las restricciones principales."
    breadcrumbs={[{ name: "Contacto", url: "/contact" }]}
>
  <!-- HERO -->
  <PageIntro eyebrow="Primera conversación" title="Cuéntanos dónde se atasca el trabajo.">
    <p>
      Puedes empezar con el proceso actual, el resultado que buscas y una restricción importante. Con eso podemos preparar preguntas útiles y un posible punto de partida.
    </p>
  </PageIntro>

  <!-- MÉTODOS DE CONTACTO -->
  <Container class="mt-24 sm:mt-32 lg:mt-40">
    <div class="grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <FadeIn>
          <h2 class="section-code">Canales directos</h2>
        </FadeIn>
        <div class="editorial-list mt-10 grid grid-cols-1">
          {methods.map((method) => (
            <FadeIn data-editorial-row class="grid grid-cols-1 gap-8 py-9 sm:grid-cols-2 sm:py-11">
              <div>
                <h3 class="section-code">{method.label}</h3>
                <a
                  href={method.href}
                  {...(method.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class:list={[
                    'mt-10 block font-display font-medium text-neutral-950 transition hover:text-brand',
                    method.label === 'Correo'
                      ? 'type-narrow whitespace-nowrap text-[clamp(1.25rem,6vw,1.875rem)] tracking-[-0.025em]'
                      : 'type-wide text-2xl tracking-tight sm:text-3xl',
                  ]}
                >
                  {method.value}
                </a>
              </div>
              <p class="text-base text-neutral-700 sm:self-end">{method.detail}</p>
            </FadeIn>
          ))}
        </div>
      </div>

      <FadeIn class="lg:col-span-3 lg:col-start-10">
          <h2 class="section-code">Para empezar</h2>
          <dl class="mt-10 grid grid-cols-1 gap-8">
            {facts.map((fact) => (
              <div>
                <dt class="type-narrow text-xs tracking-[0.1em] text-neutral-500 uppercase">{fact.label}</dt>
                <dd class="mt-2 font-display text-xl font-medium text-neutral-950">{fact.value}</dd>
              </div>
            ))}
            <div>
              <dt class="type-narrow text-xs tracking-[0.1em] text-neutral-500 uppercase">Ubicación</dt>
              <dd class="mt-2 font-display text-xl font-medium text-neutral-950">CDMX, México, remoto</dd>
            </div>
          </dl>
      </FadeIn>
    </div>
  </Container>

  <!-- ANTES DE ESCRIBIR -->
  <SectionIntro
    eyebrow="Antes de escribir"
    title="Qué nos ayuda a responderte mejor."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>Un mensaje breve con estos puntos basta para iniciar. El detalle se construye durante la conversación.</p>
  </SectionIntro>
  <Container class="mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12">
      <List class="lg:col-span-8 lg:col-start-5">
        {briefing.map((item) => (
          <ListItem>{item}</ListItem>
        ))}
      </List>
    </div>
  </Container>

  <!-- REDES -->
  <SectionIntro
    eyebrow="Redes"
    title="También nos encuentras aquí."
    class="mt-24 sm:mt-32 lg:mt-40"
  />
  <Container class="mt-12">
    <FadeIn>
      <TagList>
        {socials.map((social) => (
          <TagListItem class="transition hover:border-brand hover:text-white">
            <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label}</a>
          </TagListItem>
        ))}
      </TagList>
    </FadeIn>
  </Container>
</Layout>
