---
import Layout from '../layouts/Layout.astro';
import Container from '../components/studio/Container.astro';
import FadeIn from '../components/studio/FadeIn.astro';
import PageIntro from '../components/studio/PageIntro.astro';
import SectionIntro from '../components/studio/SectionIntro.astro';
import List from '../components/studio/List.astro';
import ListItem from '../components/studio/ListItem.astro';
import GridList from '../components/studio/GridList.astro';
import GridListItem from '../components/studio/GridListItem.astro';
import StylizedImage from '../components/studio/StylizedImage.astro';
import ContactSection from '../components/studio/ContactSection.astro';
import profileImg from '../assets/images/profile.jpg';

const values = [
  {
    title: 'Responsabilidad técnica',
    body: 'Antes de comenzar, dejamos por escrito qué construimos, qué operamos y qué depende de cada proveedor. Cuando algo requiere atención, la persona responsable está identificada.',
  },
  {
    title: 'Automatización revisable',
    body: 'Los flujos sensibles conservan bitácoras, permisos y puntos de aprobación. Automatizar tiene sentido cuando el equipo puede entender y controlar lo que ocurre.',
  },
  {
    title: 'Rendimiento medido',
    body: 'Definimos objetivos de carga y revisamos el comportamiento real antes de publicar. Las decisiones de infraestructura se apoyan en datos del proyecto.',
  },
  {
    title: 'Continuidad acordada',
    body: 'Documentamos decisiones, preparamos despliegues repetibles y separamos la estabilización inicial del mantenimiento que un proyecto pueda necesitar después.',
  },
];

const process = [
  {
    title: 'Revisar el trabajo actual',
    body: 'Primero revisamos cómo funciona el proceso actual, dónde se detiene y qué resultado importa. Si basta con una solución más simple, esa será nuestra recomendación.',
  },
  {
    title: 'Acotar la primera entrega',
    body: 'Convertimos el problema en entregables, supuestos y señales de éxito. También señalamos las dependencias que pueden cambiar el costo o el calendario.',
  },
  {
    title: 'Construir y medir',
    body: 'Desarrollamos por incrementos revisables, probamos los recorridos importantes y comparamos el resultado con los objetivos acordados.',
  },
  {
    title: 'Publicar y estabilizar',
    body: 'Después de publicar corregimos incidencias dentro del periodo acordado. Si hace falta operación continua, la definimos como un servicio separado y visible.',
  },
];
---

<Layout
    title="Estudio | edd n' dev"
    description="eddndev es el estudio de diseño y software de The Dash Studios en México. Construimos productos web, aplicaciones, automatizaciones y backends."
    breadcrumbs={[{ name: "Estudio", url: "/profile/" }]}
>
  <!-- HERO -->
  <PageIntro eyebrow="The Dash Studios · Diseño y software · México" title="Quienes proponen también construyen.">
    <p>
      Diseñamos, construimos y operamos productos web, aplicaciones y backends. Las personas que revisan el problema participan en las decisiones técnicas y acompañan la publicación.
    </p>
  </PageIntro>

  <!-- EL ESTUDIO -->
  <SectionIntro
    eyebrow="El estudio"
    title="Del backend a la interfaz."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>Trabajamos en el recorrido que conecta infraestructura, datos, lógica de producto y la interfaz que usan las personas.</p>
  </SectionIntro>
  <Container class="mt-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start">
      <FadeIn class="lg:col-span-5">
        <StylizedImage src={profileImg} alt="Eduardo Alonso, eddndev" shape={1} />
        <p class="section-code mt-5">Eduardo Alonso / Dirección técnica / México</p>
      </FadeIn>
      <FadeIn class="lg:col-span-5 lg:col-start-8">
        <div class="typography text-neutral-700">
          <p>
            eddndev pertenece a la organización
            <a href="https://thedashstudios.mx/" class="font-semibold text-neutral-950 underline decoration-1 underline-offset-2">The Dash Studios</a>, donde desarrollamos el área de tecnología, diseño y software.
          </p>
          <p>
            <strong class="font-semibold text-neutral-950">Eduardo Alonso</strong>, también eddndev, lleva la dirección técnica del estudio. La composición del equipo cambia según el proyecto y las responsabilidades acordadas.
          </p>
          <p>
            El estudio trabaja en sistemas que conectan operación, datos y producto. Cuando un proyecto incluye servidores, despliegues, rendimiento o mantenimiento, cada responsabilidad se acuerda antes de construir.
          </p>
          <p>
            El trabajo técnico y las decisiones de ingeniería se documentan en
            <a href="https://eddn.dev" target="_blank" rel="noopener noreferrer" class="font-semibold text-neutral-950 underline decoration-1 underline-offset-2">eddn.dev</a>.
          </p>
        </div>
      </FadeIn>
    </div>
  </Container>

  <!-- LO QUE NOS IMPORTA -->
  <SectionIntro
    eyebrow="Lo que nos importa"
    title="Cómo tomamos decisiones técnicas."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>Cuatro criterios para decidir qué construir, cómo comprobarlo y quién se ocupa de operarlo.</p>
  </SectionIntro>
  <Container class="mt-16">
    <GridList class="lg:grid-cols-2">
      {values.map((value) => (
        <GridListItem title={value.title}>{value.body}</GridListItem>
      ))}
    </GridList>
  </Container>

  <!-- CÓMO TRABAJAMOS -->
  <SectionIntro
    eyebrow="Proceso"
    title="Cómo trabajamos."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>
      Cada proyecto empieza con una necesidad concreta, una primera entrega revisable y una forma de saber si produjo el resultado esperado.
    </p>
  </SectionIntro>
  <Container class="mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12">
      <List class="lg:col-span-8 lg:col-start-5">
        {process.map((step) => (
          <ListItem title={step.title}>{step.body}</ListItem>
        ))}
      </List>
    </div>
  </Container>

  <!-- FILOSOFÍA -->
  <SectionIntro
    eyebrow="Responsabilidades"
    title="Qué incluye cada etapa."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>
      Código, infraestructura, seguridad y mantenimiento se dimensionan según el proyecto. La propuesta indica qué incluye la etapa, qué depende de terceros y qué se decide después.
    </p>
  </SectionIntro>

  <!-- CTA -->
  <ContactSection
    title="Hablemos del trabajo actual."
  />
</Layout>
