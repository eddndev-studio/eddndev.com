---
import Layout from '../layouts/Layout.astro';
import Container from '../components/studio/Container.astro';
import FadeIn from '../components/studio/FadeIn.astro';
import PageIntro from '../components/studio/PageIntro.astro';
import SectionIntro from '../components/studio/SectionIntro.astro';
import List from '../components/studio/List.astro';
import ListItem from '../components/studio/ListItem.astro';
import GridList from '../components/studio/GridList.astro';
import GridListItem from '../components/studio/GridListItem.astro';
import StylizedImage from '../components/studio/StylizedImage.astro';
import ContactSection from '../components/studio/ContactSection.astro';
import profileImg from '../assets/images/profile.jpg';

const values = [
  {
    title: 'Responsabilidad técnica clara',
    body: 'El alcance deja por escrito qué construyo, qué opero y qué queda en manos de cada proveedor. Así también queda claro quién responde cuando algo requiere atención.',
  },
  {
    title: 'Automatización con criterio',
    body: 'Los flujos sensibles conservan bitácoras, permisos y puntos de aprobación. Automatizar tiene sentido cuando el equipo puede entender y controlar lo que ocurre.',
  },
  {
    title: 'Rendimiento medido',
    body: 'Defino objetivos de carga y reviso el comportamiento real antes de publicar. Las decisiones de infraestructura se apoyan en datos del proyecto.',
  },
  {
    title: 'Continuidad',
    body: 'Documento decisiones, preparo despliegues repetibles y ofrezco mantenimiento cuando el proyecto necesita acompañamiento después de su lanzamiento.',
  },
];

const process = [
  {
    title: 'Entender antes de proponer',
    body: 'Primero reviso cómo funciona el proceso actual, dónde se detiene y qué resultado importa. Si basta con una solución más simple, esa será mi recomendación.',
  },
  {
    title: 'Definir una primera etapa',
    body: 'Convierto el problema en un alcance, entregables, supuestos y señales de éxito. También señalo las dependencias que pueden cambiar el costo o el calendario.',
  },
  {
    title: 'Construir y comprobar',
    body: 'Desarrollo por incrementos revisables, pruebo los recorridos importantes y preparo la publicación con observabilidad suficiente para detectar problemas.',
  },
  {
    title: 'Estabilizar y acompañar',
    body: 'Después de publicar corrijo incidencias dentro del periodo acordado. Si hace falta operación continua, la definimos como un servicio separado y visible.',
  },
];
---

<Layout
    title="Perfil | edd n' dev"
    description="Soy Eduardo Alonso, desarrollador de software independiente en México. Construyo y opero productos web, móviles y backends."
    breadcrumbs={[{ name: "Perfil", url: "/profile" }]}
>
  <!-- HERO -->
  <PageIntro eyebrow="eddndev · Desarrollo de software · México" title="Trabajo técnico con responsabilidad clara.">
    <p>
      Diseño, construyo y opero productos web, aplicaciones y backends. Trabajo directamente contigo desde el primer alcance hasta la estabilización.
    </p>
  </PageIntro>

  <!-- QUIÉN SOY -->
  <SectionIntro
    eyebrow="Quién soy"
    title="Una persona a cargo del recorrido completo."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>Construyo sistemas completos: desde la infraestructura donde vive tu proyecto hasta la interfaz que tocan tus usuarios.</p>
  </SectionIntro>
  <Container class="mt-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start">
      <FadeIn class="lg:col-span-5">
        <StylizedImage src={profileImg} alt="Eduardo Alonso, eddndev" shape={1} />
        <p class="section-code mt-5">Eduardo Alonso / México / desde 2020</p>
      </FadeIn>
      <FadeIn class="border-t border-neutral-950/20 pt-8 lg:col-span-5 lg:col-start-8">
        <div class="typography text-neutral-700">
          <p>
            Soy <strong class="font-semibold text-neutral-950">Eduardo Alonso</strong>, también eddndev. Soy desarrollador de software independiente en México. Trabajo en productos completos, desde el backend y la infraestructura hasta la interfaz que usan las personas.
          </p>
          <p>
            Mi experiencia se concentra en sistemas que conectan operación, datos y producto. Cuando el alcance incluye servidores, despliegues, rendimiento o mantenimiento, esas responsabilidades quedan descritas desde el inicio.
          </p>
          <p>
            ¿Te interesa el detalle técnico? Documento cómo pienso y construyo en
            <a href="https://eddn.dev" target="_blank" rel="noopener noreferrer" class="font-semibold text-neutral-950 underline decoration-1 underline-offset-2">eddn.dev</a>.
          </p>
        </div>
      </FadeIn>
    </div>
  </Container>

  <!-- LO QUE ME IMPORTA -->
  <SectionIntro
    eyebrow="Lo que me importa"
    title="Criterios que sostienen el trabajo."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>Cuatro criterios para tomar decisiones técnicas y mantener expectativas claras.</p>
  </SectionIntro>
  <Container class="mt-16">
    <GridList class="lg:grid-cols-2">
      {values.map((value) => (
        <GridListItem title={value.title}>{value.body}</GridListItem>
      ))}
    </GridList>
  </Container>

  <!-- CÓMO TRABAJO -->
  <SectionIntro
    eyebrow="Proceso"
    title="Cómo trabajo."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>
      Cada proyecto empieza con una necesidad concreta, un alcance revisable y una forma de saber si la primera etapa funcionó.
    </p>
  </SectionIntro>
  <Container class="mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12">
      <List class="lg:col-span-8 lg:col-start-5">
        {process.map((step) => (
          <ListItem title={step.title}>{step.body}</ListItem>
        ))}
      </List>
    </div>
  </Container>

  <!-- FILOSOFÍA -->
  <SectionIntro
    eyebrow="Alcance"
    title="Cada responsabilidad queda visible."
    class="mt-24 sm:mt-32 lg:mt-40"
  >
    <p>
      Código, infraestructura, seguridad y mantenimiento se dimensionan según el proyecto. Antes de comenzar sabrás qué incluye la etapa y qué requiere una decisión posterior.
    </p>
  </SectionIntro>

  <!-- CTA -->
  <ContactSection
    title="Cuéntame qué necesitas volver más claro."
    buttonText="Platicar el contexto"
  />
</Layout>
