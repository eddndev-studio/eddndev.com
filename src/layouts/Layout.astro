---
import '../styles/global.css';
import '@tailwindplus/elements';
import { ClientRouter } from 'astro:transitions';
import SiteNav from '../components/studio/SiteNav.astro';
import Footer from '../components/studio/Footer.astro';
import KineticCanvas from '../components/studio/KineticCanvas.astro';
import PageLoader from '../components/studio/PageLoader.astro';

interface Props {
	title?: string;
    description?: string;
    image?: string | ImageMetadata;
    project?: { title: string };
    breadcrumbs?: { name: string; url: string }[];
    noindex?: boolean;
    contactEnding?: boolean;
    structuredData?: Record<string, unknown>;
}

const {
    title = "edd n' dev | Estudio de diseño y software",
    description = "Diseño web, software y automatización en México. edd n' dev forma parte de The Dash Studios: de la idea a la publicación de tu proyecto.",
    image,
    project,
    breadcrumbs = [],
    noindex = false,
    contactEnding = false,
    structuredData,
} = Astro.props;

const canonicalPath = (path: string) => path === '/' ? '/' : `${path.replace(/\/+$/, '')}/`;
const canonicalURL = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const organizationId = 'https://eddndev.com/#organization';
const websiteId = 'https://eddndev.com/#website';

// JSON-LD: the commercial site represents the studio. Eduardo remains its technical lead.
const organizationLD = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": organizationId,
    "name": "edd n' dev",
    "alternateName": ["eddndev", "eddndev-studio"],
    "url": "https://eddndev.com/",
    "logo": "https://eddndev.com/favicon.png",
    "description": "Estudio de diseño web, software y automatización en México que forma parte de The Dash Studios.",
    "parentOrganization": {
        "@type": "Organization",
        "@id": "https://thedashstudios.mx/#organization",
        "name": "The Dash Studios",
        "url": "https://thedashstudios.mx/"
    },
    "founder": {
        "@type": "Person",
        "name": "Eduardo Alonso",
        "alternateName": "eddndev",
        "url": "https://eddn.dev"
    },
    "sameAs": [
        "https://github.com/eddndev-studio"
    ],
    "email": "contacto@eddndev.com"
};

// Stable entity identifiers connect the studio, its parent and every page.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const webSiteLD = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    "name": "edd n' dev",
    "url": "https://eddndev.com/",
    "inLanguage": "es-MX",
    "publisher": { "@id": organizationId }
};

const webPageLD = {
    "@context": "https://schema.org",
    "@type": Astro.url.pathname.startsWith('/profile/') ? 'AboutPage' : Astro.url.pathname.startsWith('/contact/') ? 'ContactPage' : 'WebPage',
    "@id": `${canonicalURL.href}#webpage`,
    "url": canonicalURL.href,
    "name": title,
    "description": description,
    "inLanguage": "es-MX",
    "isPartOf": { "@id": websiteId },
    "about": { "@id": organizationId },
    ...((project || structuredData) ? { "mainEntity": { "@id": `${canonicalURL.href}#main-entity` } } : {}),
    ...(breadcrumbs.length ? { "breadcrumb": { "@id": `${canonicalURL.href}#breadcrumb` } } : {}),
};

const mainEntityLD = structuredData || (project ? {
    "@type": "CreativeWork",
    "name": project.title,
    "description": description,
    "creator": { "@id": organizationId },
} : null);

// JSON-LD: BreadcrumbList (when breadcrumbs provided)
const breadcrumbLD = breadcrumbs.length > 0 ? {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL.href}#breadcrumb`,
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://eddndev.com/" },
        ...breadcrumbs.map((crumb, i) => ({
            "@type": "ListItem",
            "position": i + 2,
            "name": crumb.name,
            "item": new URL(canonicalPath(crumb.url), "https://eddndev.com").href
        }))
    ]
} : null;

// Dynamic OG Generator Base URL hosted on the new OG subdomain
const defaultOgUrl = new URL('https://og.eddndev.com/generate');
defaultOgUrl.searchParams.set('title', title);
defaultOgUrl.searchParams.set('tag', 'eddndev');
defaultOgUrl.searchParams.set('og_type', project ? 'Project' : 'Page');

const resolvedImage = image || defaultOgUrl.href;

let socialImageURL = "";
if (typeof resolvedImage === 'string') {
    if (resolvedImage.startsWith('http')) {
        socialImageURL = resolvedImage;
    } else {
        socialImageURL = new URL(resolvedImage, Astro.site).href;
    }
} else if (resolvedImage && typeof resolvedImage === 'object' && 'src' in resolvedImage) {
    socialImageURL = new URL(resolvedImage.src, Astro.site).href;
}
---

<!doctype html>
<html lang="es" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

        <!-- SEO / Metadata -->
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex
            ? <meta name="robots" content="noindex, follow" />
            : <link rel="canonical" href={canonicalURL} />}
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0b0910" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="edd n' dev" />
        <meta property="og:locale" content="es_MX" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={`Portada de: ${title}`} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />
        <meta property="twitter:image:alt" content={`Portada de: ${title}`} />

        <!-- Fonts (self-hosted) -->
        <link rel="preload" href="/fonts/Mona-Sans-upright.var.woff2" as="font" type="font/woff2" crossorigin />

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify(organizationLD)} />
        {!noindex && <script type="application/ld+json" set:html={JSON.stringify(webSiteLD)} />}
        {!noindex && <script type="application/ld+json" set:html={JSON.stringify(webPageLD)} />}
        {!noindex && breadcrumbLD && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />}
        {!noindex && mainEntityLD && <script type="application/ld+json" set:html={JSON.stringify({
            '@context': 'https://schema.org',
            ...mainEntityLD,
            '@id': `${canonicalURL.href}#main-entity`,
            url: canonicalURL.href,
            mainEntityOfPage: { '@id': `${canonicalURL.href}#webpage` },
        }).replace(/</g, '\\u003c')} />}

        <ClientRouter />
	</head>
	<body class="flex min-h-full flex-col bg-[var(--void)] text-white antialiased">
        <PageLoader />
        <a href="#main-content" class="cut-corner sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000] focus:bg-[var(--void)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
            Saltar al contenido
        </a>

        <SiteNav />

        <div data-nav-content class="page-surface relative flex flex-auto overflow-x-clip">
            <div class="relative isolate flex w-full flex-col">
                {!isHome && <KineticCanvas path={Astro.url.pathname} />}
                <main id="main-content" class="relative z-10 w-full flex-auto" data-project-title={project?.title}>
                    <slot />
                </main>
                <Footer compact={contactEnding} />
            </div>
        </div>

        <script src="../scripts/main.js"></script>
	</body>
</html>
