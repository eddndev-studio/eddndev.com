---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Container from '../studio/Container.astro';
import FadeIn from '../studio/FadeIn.astro';

interface Props {
  current: CollectionEntry<'work'>;
  projects: CollectionEntry<'work'>[];
}

const { current, projects } = Astro.props;
const currentIndex = projects.findIndex((project) => project.slug === current.slug);
const next = projects[(currentIndex + 1) % projects.length];
---

<Container class="mt-24 sm:mt-32 lg:mt-40">
  <FadeIn class="py-10 sm:py-14 lg:py-18">
    <p class="section-code">Siguiente caso</p>
    <article class="group relative mt-10 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <h2 class="type-wide font-display text-[clamp(3rem,7vw,7rem)] leading-[0.86] font-medium tracking-[-0.05em] text-white">
          <a href={`/work/${next.slug}`}>
            <span class="absolute inset-0"></span>
            {next.data.title}
          </a>
        </h2>
        <p class="mt-6 max-w-xl text-lg text-neutral-700">{next.data.description}</p>
        <p class="mt-8 text-sm font-semibold text-[var(--aurora)]">Ver caso</p>
      </div>
      {next.data.cover && (
        <div class="media-frame lg:col-span-5 lg:col-start-8">
          <Image src={next.data.cover} alt={next.data.title} class="scroll-media aspect-16/10 w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" />
        </div>
      )}
    </article>
  </FadeIn>
</Container>
