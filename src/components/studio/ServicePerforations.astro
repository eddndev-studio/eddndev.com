---
import type { Service } from '../../data/services';
import ArrowRightIcon from './ArrowRightIcon.astro';
import ServicePerforationIcon from './ServicePerforationIcon.astro';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
const depths = [0.04, 0.06, 0.05, 0.07];
const iconKinds = {
  'agentes-de-automatizacion': 'cpu-chip',
  'sitios-web': 'window',
  'e-commerce': 'shopping-bag',
  'software-a-medida': 'command-line',
} as const;
---

<div class="service-perforations" data-service-perforations>
  <svg
    class="service-perforations__connector"
    data-service-connector
    aria-hidden="true"
    focusable="false"
    preserveAspectRatio="none"
  >
    <path class="service-perforations__connector-path" data-service-connector-path></path>
  </svg>
  <ol class="service-perforations__scenes">
    {services.map((service, index) => {
      const side = index % 2 === 0 ? 'left' : 'right';

      return (
        <li
          class="service-scene"
          data-service-scene
          data-service-row
          data-service-index={index}
          data-perforation-side={side}
        >
          <span
            class="service-perforations__circle"
            data-service-perforation
            data-perforation-depth={depths[index] ?? 0.05}
            aria-hidden="true"
          ></span>
          <span
            class="service-perforations__viewport-icon"
            data-service-viewport-icon
            aria-hidden="true"
          >
            <span
              class="service-perforations__viewport-anchor"
              data-service-viewport-anchor
            >
              <ServicePerforationIcon kind={iconKinds[service.id] ?? 'command-line'} />
            </span>
          </span>
          <a
            href={`/services#${service.id}`}
            class="service-scene__copy"
            data-service-copy
          >
            <div class="service-scene__heading">
              <span class="section-code">{service.number}</span>
              <h3 class="service-scene__title type-wide">{service.title}</h3>
            </div>
            <div class="service-scene__detail">
              <p class="service-scene__tagline">{service.tagline}.</p>
              <p class="service-scene__highlights type-narrow">
                {service.highlights.slice(0, 2).join(' / ')}
              </p>
            </div>
            <ArrowRightIcon size="sm" class="service-scene__arrow" />
          </a>
        </li>
      );
    })}
  </ol>
</div>
