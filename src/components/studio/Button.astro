---
import ArrowRightIcon from './ArrowRightIcon.astro';

interface Props {
  href?: string;
  invert?: boolean;
  brand?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const { href, invert: _invert, brand: _brand, type = 'button', class: className, ...rest } = Astro.props;
const classes = [
  'group inline-flex min-h-11 items-center border-b border-white/40 py-2 font-display text-xs font-bold tracking-[0.12em] text-white uppercase transition duration-300 hover:border-brand hover:text-[var(--signal-on-dark)]',
  className,
];
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <span><slot /></span>
    <ArrowRightIcon size="sm" class="ml-6 transition-transform duration-300 group-hover:translate-x-1" />
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <span><slot /></span>
    <ArrowRightIcon size="sm" class="ml-6 transition-transform duration-300 group-hover:translate-x-1" />
  </button>
)}
