---
interface Props {
  class?: string;
  size?: 'sm' | 'md';
}

const { class: className, size = 'md' } = Astro.props;
const sizeClass = size === 'sm' ? 'size-4' : 'size-5';
---

<span
  class:list={['inline-flex shrink-0 items-center justify-center', sizeClass, className]}
  aria-hidden="true"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="block size-full">
    <path fill-rule="evenodd" d="M16.72 7.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06l2.47-2.47H3a.75.75 0 0 1 0-1.5h16.19l-2.47-2.47a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
  </svg>
</span>
