---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
  [key: string]: unknown;
}
const { as = 'div', class: className, ...rest } = Astro.props;
const Tag = as;
---
<Tag class:list={['mx-auto w-full max-w-[96rem] px-5 sm:px-8 lg:px-12', className]} {...rest}>
  <div class="w-full">
    <slot />
  </div>
</Tag>
