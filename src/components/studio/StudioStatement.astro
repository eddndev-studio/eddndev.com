---
import KineticStatement from './KineticStatement.astro';

const statement = "edd n'dev nació para desarrollar ideas propias. Hoy es también un estudio para construir productos y colaborar con otros equipos desde la idea hasta su publicación.";
---

<KineticStatement
  id="studio"
  label="Estudio"
  statement={statement}
  scrubStart="propias."
  accents={[
    { anchor: 'ideas', kind: 'light-bulb' },
    { anchor: 'equipos', kind: 'user-group' },
  ]}
/>
