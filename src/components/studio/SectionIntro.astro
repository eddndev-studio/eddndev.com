---
import Container from './Container.astro';
import FadeIn from './FadeIn.astro';

interface Props {
  title: string;
  eyebrow?: string;
  smaller?: boolean;
  invert?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { title, eyebrow, smaller = false, class: className, ...rest } = Astro.props;
const hasLede = Astro.slots.has('default');
---

<Container class={className} {...rest}>
  <FadeIn class="scroll-shift relative grid grid-cols-1 gap-x-8 lg:grid-cols-12">
    <h2 class="lg:col-span-8">
      {eyebrow && (
        <>
          <span class="section-code mb-8">{eyebrow}</span>
          <span class="sr-only"> - </span>
        </>
      )}
      <span
        class:list={[
          'type-wide block font-display tracking-[-0.035em] text-balance text-white',
          smaller ? 'text-3xl font-semibold' : 'text-[clamp(2.5rem,5vw,5.75rem)] leading-[0.94] font-medium',
        ]}
      >
        {title}
      </span>
    </h2>
    {hasLede && (
      <div class="mt-10 text-lg text-neutral-700 lg:col-span-4 lg:col-start-9 lg:mt-14">
        <slot />
      </div>
    )}
  </FadeIn>
</Container>
