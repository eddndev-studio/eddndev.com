---
import BrandLogo from './BrandLogo.astro';

interface Props {
  invert?: boolean;
  brand?: boolean;
  class?: string;
}

const { brand = false, class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Inicio, edd n'dev"
  class:list={['brand-lockup group inline-flex items-center', brand && 'brand-lockup--panel', className]}
>
  <BrandLogo />
</a>
