---
import { Image } from 'astro:assets';
import mark from '../../assets/images/logo.png';
import wordmark from '../../assets/images/CharLogo.png';

interface Props {
  invert?: boolean;
  brand?: boolean;
  class?: string;
}

const { brand = false, class: className } = Astro.props;
---

<a
  href="/"
  aria-label="Inicio, edd n' dev"
  class:list={['brand-lockup group inline-flex items-center gap-3', brand && 'brand-lockup--panel', className]}
>
  <span class="brand-lockup__mark" aria-hidden="true">
    <Image src={mark} alt="" width={500} height={500} loading="eager" class="h-full w-full object-contain" />
  </span>
  <Image
    src={wordmark}
    alt=""
    width={348}
    height={58}
    loading="eager"
    class="h-[1.05rem] w-auto sm:h-[1.2rem]"
  />
</a>
