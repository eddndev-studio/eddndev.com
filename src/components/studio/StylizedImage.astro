---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt?: string;
  shape?: 0 | 1 | 2;
  class?: string;
}

const { src, alt = '', class: className } = Astro.props;
---

<figure class:list={['media-frame relative aspect-4/5 w-full', className]}>
  <Image src={src} alt={alt} class="scroll-media h-full w-full object-cover" />
</figure>
