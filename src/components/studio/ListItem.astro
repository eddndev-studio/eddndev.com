---
import FadeIn from './FadeIn.astro';

interface Props { title?: string }
const { title } = Astro.props;
---

<li data-editorial-row>
  <FadeIn class="grid grid-cols-1 gap-3 py-6 sm:grid-cols-[12rem_1fr] sm:gap-8 sm:py-8">
    <div class:list={[!title && 'sm:col-start-2']}>
      {title && <strong class="font-display font-semibold text-white">{`${title}. `}</strong>}
      <slot />
    </div>
  </FadeIn>
</li>
