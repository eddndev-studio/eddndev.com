---
import Container from './Container.astro';
import Button from './Button.astro';
import Brand from './Brand.astro';
import SocialMedia from './SocialMedia.astro';
import ArrowRightIcon from './ArrowRightIcon.astro';

const rows = [
  [{ code: '01', label: 'Trabajo', href: '/work' }, { code: '02', label: 'Servicios', href: '/services' }],
  [{ code: '03', label: 'Automatización', href: '/automation' }, { code: '04', label: 'Estudio', href: '/profile' }],
];
---
<header>
  <!-- Collapsed bar -->
  <div class="absolute top-2 right-0 left-0 z-40 pt-12 sm:pt-14" data-nav-bar>
    <Container>
      <div class="flex items-center justify-between">
        <Brand />
        <div class="flex items-center gap-x-8">
          <span class="hidden sm:block"><Button href="/contact" brand>Hablemos</Button></span>
          <button
            type="button"
            data-nav-open
            aria-expanded="false"
            aria-controls="nav-panel"
            aria-label="Abrir navegación"
            class="group border border-white/20 p-3 transition duration-300 hover:border-brand"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-white transition group-hover:fill-[var(--aurora)]">
              <path d="M2 6h20v2H2zM2 16h20v2H2z" />
            </svg>
          </button>
        </div>
      </div>
    </Container>
  </div>

  <!-- Expanding panel -->
  <div
    id="nav-panel"
    data-nav-panel
    class="fixed inset-0 z-50 h-dvh overflow-x-hidden overflow-y-auto overscroll-contain bg-[var(--void)] pt-2 will-change-transform"
    aria-hidden="true"
    inert
  >
    <div class="min-h-dvh bg-[var(--night)]">
      <!-- Inverted bar with close control -->
      <div class="pt-12 pb-8 sm:pt-14 sm:pb-10">
        <Container>
          <div class="flex items-center justify-between">
            <Brand brand />
            <div class="flex items-center gap-x-8">
              <span class="hidden sm:block"><Button href="/contact" brand>Hablemos</Button></span>
              <button
                type="button"
                data-nav-close
                aria-label="Cerrar navegación"
                class="group border border-white/20 p-3 transition duration-300 hover:border-brand"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-white transition group-hover:fill-[var(--aurora)]">
                  <path d="m5.636 4.223 14.142 14.142-1.414 1.414L4.222 5.637z" />
                  <path d="M4.222 18.363 18.364 4.22l1.414 1.414L5.636 19.777z" />
                </svg>
              </button>
            </div>
          </div>
        </Container>
      </div>

      <!-- Big navigation -->
      <nav class="py-1 font-display text-5xl font-medium tracking-tight text-white sm:py-2">
        {rows.map((row) => (
          <div>
            <Container>
              <div class="grid grid-cols-1 sm:grid-cols-2">
                {row.map((item) => (
                  <a
                    href={item.href}
                    data-nav-link
                    class="group relative -mx-2 flex min-h-36 flex-col justify-between overflow-hidden px-2 py-6 sm:mx-0 sm:min-h-44 sm:px-8 sm:py-8 sm:[&:nth-child(odd)]:pl-0"
                  >
                    <span class="section-code">{item.code}</span>
                    <span class="flex items-end justify-between gap-6">
                      <span class="type-wide text-[clamp(2.5rem,6vw,5.5rem)] leading-none transition-transform duration-500 group-hover:translate-x-2">{item.label}</span>
                      <ArrowRightIcon class="mb-1 text-neutral-500 transition duration-300 group-hover:translate-x-1 group-hover:text-white" />
                    </span>
                  </a>
                ))}
              </div>
            </Container>
          </div>
        ))}
      </nav>

      <!-- Contact and social links -->
      <div class="relative mt-1">
        <Container>
          <div class="grid grid-cols-1 gap-y-8 pt-8 pb-10 sm:grid-cols-2 sm:pt-10 sm:pb-12">
            <div>
              <h2 class="font-display text-base font-semibold text-white">Contacto</h2>
              <ul role="list" class="mt-6 grid grid-cols-1 gap-8 text-sm text-neutral-300 sm:grid-cols-2">
                <li>
                  <strong class="text-white">Correo</strong><br />
                  <a href="mailto:contacto@eddndev.com" data-nav-link class="transition hover:text-white">contacto@eddndev.com</a>
                </li>
                <li>
                  <strong class="text-white">WhatsApp</strong><br />
                  <a href="https://wa.me/525560223906" target="_blank" rel="noopener noreferrer" class="transition hover:text-white">+52 55 6022 3906</a>
                </li>
              </ul>
            </div>
            <div class="sm:border-l sm:border-transparent sm:pl-16">
              <h2 class="font-display text-base font-semibold text-white">Redes</h2>
              <SocialMedia class="mt-6" invert />
            </div>
          </div>
        </Container>
      </div>
    </div>
  </div>
</header>
