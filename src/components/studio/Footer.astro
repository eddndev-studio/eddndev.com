---
import Container from './Container.astro';
import FadeIn from './FadeIn.astro';
import Brand from './Brand.astro';
import EmailLink from './EmailLink.astro';
import ArrowRightIcon from './ArrowRightIcon.astro';
import FooterContactIcon from './FooterContactIcon.astro';
import SocialMedia from './SocialMedia.astro';
import FooterSignal from './FooterSignal.astro';
import TheDashMark from '../../assets/brand/the-dash-studios-mark.svg';

const currentYear = new Date().getFullYear();
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;

const linkGroups = [
  {
    title: 'Explora',
    links: [
      { title: 'Trabajo', href: '/work/' },
      { title: 'Servicios', href: '/services/' },
      { title: 'Automatización', href: '/automation/' },
      { title: 'Estudio', href: '/profile/' },
    ],
  },
  {
    title: 'eddndev',
    links: [
      { title: 'Contacto', href: '/contact/' },
      { title: 'Blog técnico: eddn.dev', href: 'https://eddn.dev' },
      { title: 'Achronyme', href: 'https://github.com/achronyme' },
    ],
  },
];
---

<footer data-footer-colophon class:list={['footer-colophon relative z-10 w-full', { 'footer-colophon--compact': compact }]}>
  <Container>
    {!compact && <div class="footer-colophon__opening">
      <FadeIn class="footer-colophon__copy">
        <p class="section-code">Contacto</p>
        <h2 class="footer-colophon__title type-wide font-display font-medium text-balance">
          Empecemos por el trabajo actual.
        </h2>
        <p class="footer-colophon__lede text-lg">
          Cuéntanos qué ocurre hoy, qué resultado buscas y qué restricciones ya conoces. Con eso podemos preparar el siguiente paso.
        </p>
        <a data-footer-cta href="/contact/" class="footer-cta" aria-label="Iniciar conversación">
          <span class="footer-cta__label">Iniciar conversación</span>
          <span class="footer-cta__disc" aria-hidden="true">
            <ArrowRightIcon class="footer-cta__arrow" />
          </span>
        </a>
      </FadeIn>
      <FooterSignal />
    </div>}

    {!compact && <section class="footer-contact" aria-label="Contacto directo">
      <dl class="footer-contact__details text-base">
        <div class="footer-contact__item footer-contact__item--email">
          <FooterContactIcon kind="envelope" />
          <dt>Correo</dt>
          <dd><EmailLink class="footer-contact__link" /></dd>
        </div>
        <div class="footer-contact__item footer-contact__item--whatsapp">
          <FooterContactIcon kind="chat" />
          <dt>WhatsApp</dt>
          <dd><a href="https://wa.me/525560223906" target="_blank" rel="noopener noreferrer" class="footer-contact__link">+52 55 6022 3906</a></dd>
        </div>
        <div class="footer-contact__item footer-contact__item--location">
          <FooterContactIcon kind="map-pin" />
          <dt>Ubicación</dt>
          <dd>CDMX, México, remoto</dd>
        </div>
      </dl>
    </section>}

    <nav class="footer-index text-base" aria-label="Enlaces del pie de página">
      <ul role="list" class="footer-index__list">
        {linkGroups.map((row) => (
          <li data-footer-index-row class="footer-index__row">
            <div class="section-code footer-index__title">{row.title}</div>
            <ul role="list" class="footer-index__links">
              {row.links.map((link) => (
                <li><a href={link.href}>{link.title}</a></li>
              ))}
            </ul>
          </li>
        ))}
        <li data-footer-index-row class="footer-index__row">
          <div class="section-code footer-index__title">Conecta</div>
          <SocialMedia class="footer-index__socials" />
        </li>
      </ul>
    </nav>

    <div class="footer-colophon__signature">
      <div class="footer-colophon__brands">
        <Brand />
        <a class="footer-affiliation" href="https://thedashstudios.mx/">
          <TheDashMark class="footer-affiliation__mark" width="32" height="32" aria-hidden="true" focusable="false" />
          <span class="footer-affiliation__copy">
            <span class="footer-affiliation__label">Parte de la organización</span>
            <span class="footer-affiliation__name">The Dash Studios</span>
          </span>
        </a>
      </div>
      <p class="type-narrow text-sm sm:text-right">(c) 2020-{currentYear} eddndev. Todos los derechos reservados.</p>
    </div>
  </Container>
</footer>
