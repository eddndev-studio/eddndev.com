---
import Container from './Container.astro';
import FadeIn from './FadeIn.astro';
import Brand from './Brand.astro';
import Button from './Button.astro';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: 'Explora',
    links: [
      { title: 'Trabajo', href: '/work' },
      { title: 'Servicios', href: '/services' },
      { title: 'Automatización', href: '/automation' },
      { title: 'Perfil', href: '/profile' },
    ],
  },
  {
    title: 'eddndev',
    links: [
      { title: 'Contacto', href: '/contact' },
      { title: 'Blog técnico: eddn.dev', href: 'https://eddn.dev' },
      { title: 'Achronyme', href: 'https://github.com/achronyme' },
    ],
  },
  {
    title: 'Conecta',
    links: [
      { title: 'GitHub', href: 'https://github.com/eddndev' },
      { title: 'LinkedIn', href: 'https://linkedin.com/in/eddndev' },
      { title: 'X', href: 'https://x.com/eddndev' },
      { title: 'Instagram', href: 'https://instagram.com/eddn.dev' },
    ],
  },
];
---

<Container as="footer" class="relative z-10 mt-24 w-full sm:mt-32 lg:mt-40">
  <FadeIn class="border-t border-white/20 py-12 sm:py-16 lg:py-20">
    <div class="grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="section-code">Contacto</p>
        <h2 class="type-wide mt-10 font-display text-5xl leading-[0.94] font-medium tracking-[-0.04em] text-white sm:text-6xl">
          Un problema claro merece un alcance claro.
        </h2>
        <p class="mt-7 max-w-md text-neutral-300">Cuéntame qué necesitas, cómo lo resuelves hoy y qué resultado buscas. Con eso puedo proponerte un siguiente paso concreto.</p>
        <div class="mt-8"><Button href="/contact">Iniciar conversación</Button></div>
      </div>
      <nav class="lg:col-span-6 lg:col-start-7">
        <ul role="list" class="editorial-grid grid grid-cols-1 sm:grid-cols-3">
          {columns.map((section) => (
            <li data-editorial-row class="min-h-56 py-6 sm:px-6 sm:first:pl-0 sm:last:pr-0">
              <div class="section-code">{section.title}</div>
              <ul role="list" class="mt-10 text-sm text-neutral-300">
                {section.links.map((link) => (
                  <li class="mt-4 first:mt-0">
                    <a href={link.href} class="transition-colors hover:text-[var(--aurora)]">{link.title}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="mt-20 grid grid-cols-1 items-end gap-6 border-t border-white/10 pt-8 sm:grid-cols-2">
      <Brand />
      <p class="type-narrow text-sm text-neutral-300 sm:text-right">(c) 2020-{currentYear} eddndev. Todos los derechos reservados.</p>
    </div>
  </FadeIn>
</Container>
