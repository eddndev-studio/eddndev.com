---
import {
  getLayerTransform,
  LAYER_COUNT,
  matrix,
} from '../../scripts/features/ensamble/model.js';
import logo from '../../assets/images/eddndev.svg?raw';

const profile = logo.match(/<path\b[^>]*\bd="([^"]+)"/)?.[1];
if (!profile) throw new Error('The ensamble requires the vector brand profile.');
---

<svg
  class="ensamble-object"
  id="ensamble-object"
  viewBox="0 0 720 720"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <path
      id="ensamble-profile"
      d={profile}
      transform="translate(-192 -120)"
      fill-rule="evenodd"
    ></path>
    <linearGradient id="ensamble-face" x1="0" y1="0" x2="1" y2="1"
      ><stop offset="0" stop-color="#e5d9f5"></stop><stop
        offset=".26"
        stop-color="#c9b5ee"></stop><stop offset=".64" stop-color="#a18bc8"
      ></stop><stop offset="1" stop-color="#756898"></stop></linearGradient
    >
    <linearGradient id="ensamble-edge" x1="0" y1="0" x2=".8" y2="1"
      ><stop stop-color="#c5b2ec"></stop><stop offset=".44" stop-color="#8d77b4"
      ></stop><stop offset="1" stop-color="#435bb9"></stop></linearGradient
    >
    <linearGradient id="ensamble-body-metal" x1="0" y1="0" x2="1" y2=".8"
      ><stop stop-color="#7a68a3"></stop><stop offset=".26" stop-color="#242033"
      ></stop><stop offset=".6" stop-color="#514464"></stop><stop
        offset="1"
        stop-color="#526ae6"></stop></linearGradient
    >
  </defs>
  <g
    class="ensamble-structure-guides"
    fill="none"
    stroke="#7c88f5"
    stroke-width=".75"
    ><path
      d="M105 160H625M105 560H625M135 125V595M585 125V595"
      stroke-dasharray="3 7"></path><circle
      cx="360"
      cy="360"
      r="238"
      stroke-dasharray="2 12"></circle><path
      d="M100 360H620M360 100V620"
      stroke-opacity=".5"></path></g
  >
  <g class="ensamble-laminae">
    {
      Array.from({ length: LAYER_COUNT }, (_, index) => {
        const fill = `url(#ensamble-${index === LAYER_COUNT - 1 ? 'face' : index >= Math.floor(LAYER_COUNT * 0.8) ? 'edge' : 'body-metal'})`;
        return (
          <g
            class="ensamble-lamina"
            transform={matrix(getLayerTransform({ index }))}
          >
            <use
              href="#ensamble-profile"
              fill={fill}
              stroke="#a58fce"
              stroke-opacity=".67"
              stroke-width=".8"
            />
          </g>
        );
      })
    }
  </g>
</svg>
